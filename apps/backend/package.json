{
  "name": "@the-desk/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@the-desk/shared": "workspace:*",
    "@prisma/client": "^5.20.0",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "@types/node": "^22.7.4",
    "oxlint": "^1.0.0"
  }
}
