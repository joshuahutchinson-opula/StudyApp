generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Discipline {
  medicine
  software
  writing
  engineering
  arts
}

enum MasteryLevel {
  unfamiliar
  learning
  familiar
  mastered
}

enum TaskStatus {
  backlog
  todo
  in_progress
  done
}

enum DeadlineSource {
  manual
  syllabus_import
}

enum StudyMode {
  pomodoro
  deep_work
  free
}

enum GraphEdgeKind {
  cites
  references
  tags
  ai_suggested
  manual
}

enum CitationStyle {
  ama
  ieee
  mla
  chicago
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  displayName     String
  activeDiscipline Discipline
  // Tier 7's user desk/wall customization: a partial override of that
  // discipline's DeskTheme (desk wood + wall color only — see
  // scene/disciplineTheme.ts), merged on top of the discipline default
  // rather than replacing it. Null means "just use the discipline default."
  deskThemeOverride Json?
  // Tier 9's rearrangeable desk: { [objectKey]: slotIndex }. Deliberately
  // limited to objects with NO dedicated camera-approach state (currently
  // just the timer) — every approach state's camera target is hand-placed
  // and fixed per the brief ("never computed at runtime"), so an object
  // that has one can't be freely repositioned without desyncing its
  // camera's framing from where the object actually sits.
  deskLayoutOverride Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  binders          Binder[]
  tasks            Task[]
  deadlines        Deadline[]
  studySessions    StudySession[]
  cards            SpacedRepetitionCard[]
  graphEdges       GraphEdge[]
  caseAttempts     CaseAttempt[]
  citations        Citation[]
  syncDocs         SyncDoc[]
}

// Offline-first CRDT sync (Tier 3 of the 3D pivot): the merged Yjs binary
// state for one synced document, keyed per (user, docKey). The server
// merges an incoming update into whatever's already stored via Y.applyUpdate
// rather than overwriting — two devices that edited the same doc while
// offline converge on reconnect instead of one clobbering the other. That
// merge happens in the sync route (src/routes/sync.ts), not here; this
// table is just the durable home for the resulting bytes.
model SyncDoc {
  id        String   @id @default(uuid())
  userId    String
  docKey    String
  state     Bytes
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, docKey])
}

// Tier 4's "textbook-as-object": read-only reference material, one per
// discipline, distinct from a user's own Binder (their notes). Shared
// across all users of a discipline rather than owned by one — no userId,
// same pattern as ClinicalCase.
model Textbook {
  id         String     @id @default(uuid())
  discipline Discipline
  title      String
  author     String
  createdAt  DateTime   @default(now())

  chapters TextbookChapter[]

  @@index([discipline])
}

model TextbookChapter {
  id         String   @id @default(uuid())
  textbookId String
  textbook   Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  title      String
  order      Int
  // Block[] (see @the-desk/shared BlockSchema), same shape as Page.content —
  // read-only here, but "file to binder" (Tier 4) copies it into a real,
  // editable Page.
  content    Json     @default("[]")

  @@index([textbookId])
}

// A bound note collection: spine, cover, pages — not a scrolling document.
model Binder {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline Discipline
  title      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tabDividers TabDivider[]
  pages       Page[]

  @@index([userId])
}

// Color-coded tab on the edge of a binder for fast subject/unit switching.
model TabDivider {
  id       String @id @default(uuid())
  binderId String
  binder   Binder @relation(fields: [binderId], references: [id], onDelete: Cascade)
  label    String
  color    String
  order    Int

  pages Page[]

  @@index([binderId])
}

model Page {
  id           String       @id @default(uuid())
  binderId     String
  binder       Binder       @relation(fields: [binderId], references: [id], onDelete: Cascade)
  tabDividerId String?
  tabDivider   TabDivider?  @relation(fields: [tabDividerId], references: [id], onDelete: SetNull)
  title        String
  order        Int
  // Array of Block (see @the-desk/shared BlockSchema), stored as JSONB.
  content      Json         @default("[]")
  masteryLevel MasteryLevel @default(unfamiliar)
  reviewed     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  annotations MarginAnnotation[]
  cards       SpacedRepetitionCard[]
  revisions   PageRevision[]
  critiqueThreads CritiqueThread[]

  @@index([binderId])
  @@index([tabDividerId])
}

model MarginAnnotation {
  id            String   @id @default(uuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  anchorBlockId String
  body          String
  createdAt     DateTime @default(now())

  @@index([pageId])
}

// Writing's signature feature: a git-history-like manuscript timeline with
// rewind. A snapshot of `content` is taken automatically before every edit
// (see PATCH /pages/:id/content), so history requires no manual "save
// version" step — editing itself is what populates the timeline.
model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content   Json
  createdAt DateTime @default(now())

  @@index([pageId])
}

model Task {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline        Discipline
  title             String
  description       String?
  status            TaskStatus  @default(todo)
  parentTaskId      String?
  parentTask        Task?       @relation("TaskDependencies", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks          Task[]      @relation("TaskDependencies")
  dueAt             DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  deadlines Deadline[]

  @@index([userId])
  @@index([parentTaskId])
}

model Deadline {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  dueAt          DateTime
  source         DeadlineSource @default(manual)
  relatedTaskId  String?
  relatedTask    Task?          @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  recurrenceRule String?
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([relatedTaskId])
}

model StudySession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode         StudyMode
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  focusMinutes Int       @default(0)

  @@index([userId])
}

// Generalized spaced-repetition card powering flashcards, terminology drills, vocab, etc.
model SpacedRepetitionCard {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline    Discipline
  sourcePageId  String?
  sourcePage    Page?        @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  front         String
  back          String
  masteryLevel  MasteryLevel @default(unfamiliar)
  dueAt         DateTime     @default(now())
  intervalDays  Float        @default(0)
  easeFactor    Float        @default(2.5)
  reviewCount   Int          @default(0)

  @@index([userId])
  @@index([sourcePageId])
}

// Persisted user-drawn (or future AI-suggested) links, layered on top of the
// derived graph in routes/graph.ts. The original design here was a real
// GraphNode table with FK-based edges, but the graph view that actually got
// built derives its nodes on read from existing tables using synthetic
// string refs ("page:<uuid>", "card:<uuid>", "task:<uuid>") rather than
// persisting a parallel node table that could drift out of sync — so this
// stores refs directly instead of foreign keys to a GraphNode that doesn't
// otherwise exist. GraphNode itself was unused (zero rows, zero references)
// and is removed rather than kept as dead weight.
model GraphEdge {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline Discipline
  sourceRef  String
  targetRef  String
  kind       GraphEdgeKind @default(manual)
  createdAt  DateTime      @default(now())

  @@index([userId, discipline])
}

model Citation {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  discipline Discipline
  style      CitationStyle
  sourceType String
  title      String
  authors    String[]
  year       Int?
  publisher  String?
  url        String?
  doi        String?
  createdAt  DateTime      @default(now())

  @@index([userId])
}

// Medicine's signature feature: a case vignette the student builds a
// differential and orders tests against, then gets rubric-based feedback.
// Engine-specific (not part of the shared spine), unlike SpacedRepetitionCard.
model ClinicalCase {
  id                  String   @id @default(uuid())
  title               String
  vignette            String
  // DifferentialOption[]: [{ label: string, weight: "primary"|"reasonable"|"unlikely" }]
  differentialOptions Json
  // TestOption[]: [{ label: string, indicated: boolean }]
  testOptions         Json
  createdAt           DateTime @default(now())

  attempts CaseAttempt[]
}

model CaseAttempt {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId       String
  case         ClinicalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  differential String[]
  orderedTests String[]
  score        Float
  // CaseFeedback: see backend src/rubric.ts for the shape
  feedback     Json
  createdAt    DateTime     @default(now())

  @@index([userId])
  @@index([caseId])
}

// Arts' signature feature: threaded, point-specific feedback pinned to a
// position on an image block — Figma-comments-style, but for visual/physical
// work-in-progress. Point-specific rather than page-level like margin notes,
// since critique on a piece is inherently about a location within the image,
// not a location within the surrounding text.
model CritiqueThread {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  // Percentage position (0-100) within the image, so pins stay correctly
  // placed regardless of the rendered image size.
  x         Float
  y         Float
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  comments CritiqueComment[]

  @@index([pageId])
}

model CritiqueComment {
  id         String         @id @default(uuid())
  threadId   String
  thread     CritiqueThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorName String
  body       String
  createdAt  DateTime       @default(now())

  @@index([threadId])
}
